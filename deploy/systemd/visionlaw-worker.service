[Unit]
Description=Vision Law queue worker (spec 009 reminder delivery)
After=network.target visionlaw-web.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vision-law
ExecStart=/usr/bin/php /opt/vision-law/artisan queue:work database --sleep=3 --tries=1 --timeout=120 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
