# Vision Law agent service — env NAMES only. Real values live in the
# service env file on the server (systemd EnvironmentFile), never in git.
#
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8100
# AGENT_RUNNER=claude            # or google_adk (stub)
# AGENT_INTERNAL_TOKEN=          # shared with Laravel AGENT_INTERNAL_TOKEN
# LARAVEL_INTERNAL_URL=http://127.0.0.1:3100
#
# Provider (ENV ONLY — DeepSeek example shown; Anthropic or GLM use the
# same variable names with their own base URL / key):
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=deepseek-flash[1m]
# ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash[1m]
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
# CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash
